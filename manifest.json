{
  "manifest_version": 3,
  "name": "GlyphProbe",
  "version": "0.1.0",
  "description": "Insert Unicode probe characters into a field and detect how the application transforms them (normalization, case mapping, Windows best-fit).",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "GlyphProbe",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "src/data/bestfit.js",
        "src/data/probes.js",
        "src/lib/transforms.js",
        "src/lib/detect.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
